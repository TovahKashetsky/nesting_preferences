**Response variables:**

-   New_nests_os: number of new osmia nests for each trapnest and date combination.
-   New_nests_meg: number of new megachile nests for each trapnest and date combination.
-   Prop_filled: proportion of the straw filled with cells, used as a measure of investment into a nest.

**Predictor variables:**

-   Available_cavities_prior: number of available cavities that could have had a new nest built between visits.
-   Osmia_ps_prior: number of existing osmia in each trapnest per date, including pseudo nests.
-   Osmia_no_ps_prior: number of existing osmia in each trapnest per date, excluding pseudo nests.
-   Meg_ps_prior: number of existing megachile in each trapnest per date, including pseudo nests.
-   Meg_no_ps_prior: number of existing megachile in each trapnest per date, excluding pseudo nests.
-   Par_in_trapnest: number of parasites present in the trapnest when I log new bee nests (Bee_choice).

**Additional variables:**

-   Good_days: number of days between visits with good enough weather for bee activity.
-   Day_of_year: the day of the year, a stand in for date.
-   Site: three sites in total.
-   Subsite: six subsites for each site, unique to each site.
-   Trapnest: 72 trapnests total, ach subsite contains three, unique to each subsite.



```{r Prep, include=FALSE, include=TRUE}


## Loading packages

library(glmmTMB)
library(DHARMa)
library(lme4)
library(car)
library(see)
library(performance)
library(sjPlot) # for plot_model
library(ggplot2)
library(ggeffects)
library(effects)
library(tidyverse)
library(interactions) # for interact_plot
library(betareg)


## Loading data

nesting <- read_csv('data/nesting_cleaned_all_bees.csv')
nesting_os <- read_csv('data/nesting_cleaned_osmia.csv')
nesting_meg <- read_csv('data/nesting_cleaned_megachile.csv') # three columns with parasite and cell info blank, not dissected
nesting_os_xs <- read_csv('data/nesting_cleaned_osmia_xs.csv')
nesting_meg_xs <- read_csv('data/nesting_cleaned_megachile_xs.csv')
nesting_cells_os <- read_csv('data/nesting_cells_cleaned_osia.csv')
nesting_investment <- read_csv('data/investment_cleaned.csv')
investment_os <- nesting_investment %>% filter(Occupant == 'osmia') 


## Checking form of Day_of_year

plot(I(New_nests_os/ (Available_cavities_prior)) ~ (Day_of_year), data=nesting_os_xs)
plot(I(New_nests_os/ (Osmia_no_ps_prior)) ~ (Day_of_year), data=nesting_os_xs)
plot(I(New_nests_meg/ (Meg_no_ps_prior)) ~ (Day_of_year), data=nesting_meg_xs)


## Notes
# in ggpredict(), the percentages on the y-axis are the predicted probabilities of the response variable (e.g., new nests) at each of the x axis values (e.g., number of osmia in the trapnest)
# in interact_plot(), the y-axis are the predicted values of the outcome variable (e.g., proportion of straw filled) with the different combinations of the two main predictors (e.g., number of parasitized unsealed nests and if the focal nest is parasitized)


```



### Nesting per Available Cavities



```{r Models: Nest per Available Cavities, include=TRUE}


# MODEL 1 
### New nests per available cavities Osmia ###
mod_choice_cav_os <- glmer(cbind(New_nests_os, Available_cavities_prior - New_nests_sum) ~ scale(Available_cavities_prior) + scale(Good_days) + poly(Day_of_year,2) + Site + (1|Subsite/Trapnest), data = nesting_os_xs, family = binomial(), control = glmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 1000000))) # ignore boudnary singular fit warning, means random effects don't account for much

plot(simulateResiduals(mod_choice_cav_os)) # fine
check_model(mod_choice_cav_os) # fine
testDispersion(mod_choice_cav_os, type = 'DHARMa') # good
testZeroInflation(mod_choice_cav_os) # good
vif(mod_choice_cav_os) # good
summary(mod_choice_cav_os) # Significant effect of good days, site, day of year

ggpredict(mod_choice_cav_os, c('Available_cavities_prior')) %>% plot(rawdata = TRUE, jitter = .04)


# MODEL 2
### New nests per available cavities Megachile ###
mod_choice_cav_meg <- glmer(cbind(New_nests_meg, Available_cavities_prior - New_nests_sum) ~ scale(Available_cavities_prior) + scale(Good_days) + poly(Day_of_year,2)  + Site + (1|Subsite/Trapnest), data = nesting_meg_xs, family = binomial(), control = glmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 1000000)))

plot(simulateResiduals(mod_choice_cav_meg)) # fine
check_model(mod_choice_cav_meg) # fine
testDispersion(mod_choice_cav_meg, type = 'DHARMa') # fine
testZeroInflation(mod_choice_cav_meg) # good
summary(mod_choice_cav_meg) # significant effect of site
vif(mod_choice_cav_meg)

# Plot model
ggpredict(mod_choice_cav_meg, c('Available_cavities_prior')) %>% plot(rawdata = TRUE, jitter = .04) 

```



### Nesting per Conspecific Presence



```{r Models: Nest per Conspecifics Osmia, include=TRUE}


# MODEL 3 
### New nests per conspecifics Osmia, with pseudo ###

mod_choice_consp_os_ps <- glmer(cbind(New_nests_os, Available_cavities_prior - New_nests_sum) ~ scale(Osmia_ps_prior) + scale(Good_days) + poly(Day_of_year,2) + Site + (1|Subsite/Trapnest), data = nesting_os_xs, family = binomial) # ignore boundary singular warning, means little to no influence of random effects

plot(simulateResiduals(mod_choice_consp_os_ps)) # fine
check_model(mod_choice_consp_os_ps) # fine
testDispersion(mod_choice_consp_os_ps, type = 'DHARMa') # good
testZeroInflation(mod_choice_consp_os_ps) # some zero-inflation, but not detrimental
summary(mod_choice_consp_os_ps) # significant effect of conspecifics, good days, date, and site
vif(mod_choice_consp_os_ps) # good

# specify my range of values for Osmia_ps_prior
values_osmia_ps <- seq(min(nesting_os_xs$Osmia_ps_prior), 
                    max(nesting_os_xs$Osmia_ps_prior), 
                    length.out = 100)
# compute marginal effects at specific values of Osmia_ps_prior
marginal_effects_os_ps <- ggpredict(mod_choice_consp_os_ps, 
                              terms = "Osmia_ps_prior [all]", 
                              conditions = list(Osmia_ps_prior = values_osmia_ps))
# plot
plot(marginal_effects_os_ps, rawdata = TRUE, jitter = 0.04)


# MODEL 4 
### New nests per conspecifics Osmia, without pseudo ###

# Fit the GLMM model with custom glmerControl
mod_choice_consp_os_no_ps <- glmer(cbind(New_nests_os, Available_cavities_prior - New_nests_sum) ~ scale(Osmia_no_ps_prior) + scale(Good_days) + poly(Day_of_year, 2) + Site + (1|Subsite) + (1|Trapnest), data = nesting_os_xs, family = binomial(), control = glmerControl(optimizer = "nloptwrap", optCtrl = list(maxeval = 100000)))

plot(simulateResiduals(mod_choice_consp_os_no_ps)) # fine
testDispersion(mod_choice_consp_os_no_ps) # good
testZeroInflation(mod_choice_consp_os_no_ps) # fine
summary(mod_choice_consp_os_no_ps) # significant effect of conspecifics, good days, date, and site
vif(mod_choice_consp_os_no_ps) # good

# specify my range of values for Osmia_no_ps_prior
values_osmia_no_ps <- seq(min(nesting_os_xs$Osmia_no_ps_prior), 
                    max(nesting_os_xs$Osmia_no_ps_prior), 
                    length.out = 100)
# compute marginal effects at specific values of Osmia_ps_prior
marginal_effects_os_no_ps <- ggpredict(mod_choice_consp_os_no_ps, 
                              terms = "Osmia_no_ps_prior [all]", 
                              conditions = list(Osmia_no_ps_prior = values_osmia_no_ps))
# plot
plot(marginal_effects_os_no_ps, rawdata = TRUE, jitter = 0.04)

```



------------------------------------------------------------------------



```{r Models: Nest per Conspecifics Megachile, include=TRUE}



# MODEL 5
### New nests per conspecifics Megachile, with pseudo ###
mod_choice_consp_meg_ps <- glmer(cbind(New_nests_meg, Available_cavities_prior - New_nests_sum) ~ scale(Meg_ps_prior) + scale(Good_days) + poly(Day_of_year,2) + Site + (1|Subsite/Trapnest), data = nesting_meg_xs, family = binomial(), control = glmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 1000000)))

plot(simulateResiduals(mod_choice_consp_meg_ps)) # great
check_model(mod_choice_consp_meg_ps) # good
testDispersion(mod_choice_consp_meg_ps, type = 'DHARMa') # good
testZeroInflation(mod_choice_consp_meg_ps) # good
summary(mod_choice_consp_meg_ps) # significant effect of site (CP) and day of year
vif(mod_choice_consp_meg_ps)

# plot
values_meg_ps <- seq(min(nesting_meg_xs$Meg_ps_prior), 
                    max(nesting_meg_xs$Meg_ps_prior), 
                    length.out = 100)
marginal_effects_meg_ps <- ggpredict(mod_choice_consp_meg_ps, 
                              terms = "Meg_ps_prior [all]", 
                              conditions = list(Meg_ps_prior = values_meg_ps))
plot(marginal_effects_meg_ps, rawdata = TRUE, jitter = 0.04)

# MODEL 6
### New nests per conspecifics Megachile, without pseudo ###
mod_choice_consp_meg_no_ps <- glmer(cbind(New_nests_meg, Available_cavities_prior - New_nests_sum) ~ scale(Meg_no_ps_prior) + scale(Good_days) + poly(Day_of_year,2) + Site + (1|Subsite/Trapnest), data = nesting_meg_xs, family = binomial(), control = glmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 1000000)))

plot(simulateResiduals(mod_choice_consp_meg_no_ps)) # great
check_model(mod_choice_consp_meg_no_ps) # good
testDispersion(mod_choice_consp_meg_no_ps, type = 'DHARMa') # good 
testZeroInflation(mod_choice_consp_meg_no_ps) # good
summary(mod_choice_consp_meg_no_ps) # significant effect of conspecifics, sites and day of year
vif(mod_choice_consp_meg_no_ps) # good

# plot
values_meg_no_ps <- seq(min(nesting_meg_xs$Meg_no_ps_prior), 
                    max(nesting_meg_xs$Meg_no_ps_prior), 
                    length.out = 100)
marginal_effects_meg_no_ps <- ggpredict(mod_choice_consp_meg_no_ps, 
                              terms = "Meg_no_ps_prior [all]", 
                              conditions = list(Meg_no_ps_prior = values_meg_no_ps))
plot(marginal_effects_meg_no_ps, rawdata = TRUE, jitter = 0.04)


```



### Parasitism



```{r Parasites and Aggregations, include=TRUE}

# Relation between parasites and aggregation densities

# MODEL 7
# Relation between parasites and aggregation densities, with pseudo

mod_par_agg_ps <- glmer(cbind(Sum_cell_parasitized, Sum_cell_not_parasitized) ~ scale(Osmia_ps_no_iw) + poly(Day_of_year,2)  + Site + (1|Subsite/Trapnest/Nest_ID), data = nesting_cells_os, family = binomial)

plot(simulateResiduals(mod_par_agg_ps)) # good
check_model(mod_par_agg_ps) # good
testDispersion(mod_par_agg_ps, type = 'DHARMa') # good
testZeroInflation(mod_par_agg_ps) # good
summary(mod_par_agg_ps) # no detected effects
vif(mod_par_agg_ps)

# plot
values_osmia_ps_no_iw <- seq(min(nesting_cells_os$Osmia_ps_no_iw, na.rm = TRUE), 
                              max(nesting_cells_os$Osmia_ps_no_iw, na.rm = TRUE), 
                              length.out = 100)
marginal_effects_os_ps_no_iw <- ggpredict(mod_par_agg_ps, 
                              terms = "Osmia_ps_no_iw [all]", 
                              conditions = list(Osmia_ps_no_iw = values_osmia_ps_no_iw))
plot(marginal_effects_os_ps_no_iw, rawdata = TRUE, jitter = 0.04)


# MODEL 8
# Relation between parasites and aggregation densities, without pseudo

mod_par_agg_no_ps <- glmer(cbind(Sum_cell_parasitized, Sum_cell_not_parasitized) ~ scale(Osmia_no_ps_no_iw) + poly(Day_of_year,2) + Site + (1|Subsite/Trapnest/Nest_ID), data = nesting_cells_os, family = binomial)

plot(simulateResiduals(mod_par_agg_no_ps)) # WEIRD!
check_model(mod_par_agg_no_ps) # fine
testDispersion(mod_par_agg_no_ps, type = 'DHARMa') # good
testZeroInflation(mod_par_agg_no_ps) # good
summary(mod_par_agg_no_ps) # no detected effects
vif(mod_par_agg_no_ps)

table(nesting_cells_os$Site) # very few CP

# plot
values_osmia_no_ps_no_iw <- seq(min(nesting_cells_os$Osmia_no_ps_no_iw, na.rm = TRUE), 
                                max(nesting_cells_os$Osmia_no_ps_no_iw, na.rm = TRUE), 
                                length.out = 100)
marginal_effects_os_no_ps_no_iw <- ggpredict(mod_par_agg_no_ps, 
                              terms = "Osmia_no_ps_no_iw [all]", 
                              conditions = list(Osmia_no_ps_no_iw = values_osmia_no_ps_no_iw))
plot(marginal_effects_os_no_ps_no_iw, rawdata = TRUE, jitter = 0.04)


# MODEL 9
# Relation between parasites and aggregation densities, unsealed

mod_par_agg_unsealed_os <- glmer(cbind(Sum_cell_parasitized, Sum_cell_not_parasitized) ~ scale(Sum_unsealed_os_no_iw) + poly(Day_of_year,2) + Site + (1|Subsite/Trapnest/Nest_ID), data = nesting_cells_os, family = binomial)

plot(simulateResiduals(mod_par_agg_unsealed_os)) # good
check_model(mod_par_agg_unsealed_os) # fine
testDispersion(mod_par_agg_unsealed_os, type = 'DHARMa') # good
testZeroInflation(mod_par_agg_unsealed_os) # good
summary(mod_par_agg_unsealed_os) 
vif(mod_par_agg_unsealed_os) # no detected effects

# plot
values_unsealed_os_no_iw <- seq(min(nesting_cells_os$Sum_unsealed_os_no_iw, na.rm = TRUE), 
                                     max(nesting_cells_os$Sum_unsealed_os_no_iw, na.rm = TRUE), 
                                     length.out = 100)
marginal_effects_unsealed_os_no_iw <- ggpredict(mod_par_agg_unsealed_os, 
                              terms = "Sum_unsealed_os_no_iw [all]", 
                              conditions = list(Sum_unsealed_os_no_iw = values_unsealed_os_no_iw))
plot(marginal_effects_unsealed_os_no_iw, rawdata = TRUE, jitter = 0.04)

```

```{r Preferences and Parasites, include=TRUE}


# MODEL 10
# How the presence of parasites effects nesting preferences, with pseudo

mod_choice_par_ps_os <- glmer(cbind(New_nests_os, Available_cavities_prior - New_nests_sum) ~ scale(DP_os_prior) * scale(NDP_ps_os_prior) + scale(Good_days) + poly(Day_of_year,2) + Site + (1|Subsite/Trapnest), data = nesting_os_xs, family = binomial, control = glmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 1000000))) 
# having subsite doesnt change model

plot(simulateResiduals(mod_choice_par_ps_os)) # fine
check_model(mod_choice_par_ps_os) # fine
testDispersion(mod_choice_par_ps_os, type = 'DHARMa') # good
testZeroInflation(mod_choice_par_ps_os) # fine
summary(mod_choice_par_ps_os) # significant effect of parasitized unsealed nests, conspecifics, good days, day of year, and site
vif(mod_choice_par_ps_os) # good

interact_plot(mod_choice_par_ps_os, pred = NDP_ps_os_prior, modx = DP_os_prior, data = nesting_os_xs)


# Model 11
# How the presence of parasites effects nesting preferences, without pseudo

mod_choice_par_no_ps_os <- glmer(cbind(New_nests_os, Available_cavities_prior - New_nests_sum) ~ scale(DP_os_prior) * scale(NDP_os_prior) + scale(Good_days) + poly(Day_of_year,2) + Site + (1|Subsite/Trapnest), data = nesting_os_xs, family = binomial, control=glmerControl(optimizer="bobyqa", optCtrl=list(maxfun=1000000))) 

plot(simulateResiduals(mod_choice_par_no_ps_os)) # good
check_model(mod_choice_par_no_ps_os) # fine
testDispersion(mod_choice_par_no_ps_os, type = 'DHARMa') # good
testZeroInflation(mod_choice_par_no_ps_os) # good
summary(mod_choice_par_no_ps_os) # significant effect of parasitized unsealed nests, conspecifics, parasitized unsealed nests*conspecifics, good days, day of year, and site
vif(mod_choice_par_no_ps_os)

interact_plot(mod_choice_par_no_ps_os, pred = NDP_os_prior, modx = DP_os_prior, data = nesting_os_xs)


```

```{r Investment, include=TRUE}

# MODEL 12
# Likelyhood of  of terminating nest investment after a cell was parasitized

mod_last_cell <- glmer(Last_cell ~ Cell_parasitized + Day_of_year + Site + (1|Nest_ID), data = nesting_cells_os, family = binomial)

plot(simulateResiduals(mod_last_cell)) # good
summary(mod_last_cell) # significant effect of day of year
vif(mod_last_cell) # good

ggpredict(mod_last_cell, c('Cell_parasitized')) %>% plot(rawdata = TRUE, jitter = .04) 


# MODEL 13
# Investment into a nest if other active nests or the nest itself is parasitized

mod_invest_filled <- glmer(cbind(Filled_length, Straw_length) ~ scale(DP_os_prior) * Nest_parasitized + poly(Day_of_year,2) + Site + (1|Subsite/Trapnest), data = investment_os, family = binomial, control=glmerControl(optimizer="bobyqa", optCtrl=list(maxfun=1000000)))

plot(simulateResiduals(mod_invest_filled)) # fine
check_model(mod_invest_filled) # fine
summary(mod_invest_filled) # significant effect of parasitized unsealed nests, if focal nest is parasitized, good days, day of year, and site
vif(mod_invest_filled) # good

interact_plot(mod_invest_filled, pred = DP_os_prior, modx = Nest_parasitized, data = investment_os)


```

```{r Ignore, include=TRUE}


## how related are my treatments to the number of available cavities?

mod_treatment_validation <- lm(Available_cavities_prior ~ Treatment, data = nesting)
summary(mod_treatment_validation)
ggpredict(mod_treatment_validation, c('Treatment')) # predicted number of cavities is excellent


## checking unscaled estimates

mean_meg_no_ps_prior <- mean(nesting_meg_xs$Meg_no_ps_prior)
sd_meg_no_ps_prior <- sd(nesting_meg_xs$Meg_no_ps_prior)
scaled_estimate_meg <- 0.2578
unscaled_estimate_meg <- scaled_estimate_meg * sd_meg_no_ps_prior + mean_meg_no_ps_prior
unscaled_estimate_meg

mean_os_no_ps_prior <- mean(nesting_os_xs$Osmia_no_ps_prior)
sd_os_no_ps_prior <- sd(nesting_os_xs$Osmia_no_ps_prior)
scaled_estimate_os <- 0.36480
unscaled_estimate_os <- scaled_estimate_os * mean_os_no_ps_prior + mean_os_no_ps_prior
unscaled_estimate_os


